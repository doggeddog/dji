#!/usr/bin/env bash
#
# dlog — DJI D-Log 视频色彩转换工具
#
# 将灰蒙蒙的 D-Log / D-Log M 视频转换为 Rec.709 标准色彩。
# 基于 ffmpeg + 3D LUT，支持 macOS 硬件加速编码。
#
set -eo pipefail

VERSION="1.1.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# LUT 搜索目录
if [[ -n "${DLOG_DATA_DIR:-}" ]]; then
    DATA_DIR="$DLOG_DATA_DIR"
elif [[ -d "$HOME/.local/share/dlog" ]]; then
    DATA_DIR="$HOME/.local/share/dlog"
else
    DATA_DIR="/usr/local/share/dlog"
fi

# ── LUT 预设 ───────────────────────────────────────────
# vivid  = 鲜艳模式 (默认)
# std    = 标准 D-Log to Rec.709
# dlogm  = D-Log M to Rec.709
KNOWN_PRESETS="vivid std dlogm"
DEFAULT_PRESET="vivid"

# ── 默认参数 ────────────────────────────────────────────
CODEC="h265"
QUALITY=22
BITRATE=""
LUT_FILE=""
LUT_PRESET=""
OUTPUT_DIR=""
SUFFIX="_rec709"
DRY_RUN=false
OVERWRITE=false
PARALLEL=1
VERBOSE=false
LIST_LUTS=false

# ── 颜色输出 ────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${BLUE}ℹ${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
err()   { echo -e "${RED}✗${NC} $*" >&2; }

# ── 帮助信息 ────────────────────────────────────────────
usage() {
    cat <<EOF
dlog v${VERSION} — DJI D-Log 视频色彩转换工具

用法:
  dlog                            转换当前目录所有 _D 视频 (默认 vivid)
  dlog <文件...>                  转换指定文件
  dlog -l std <文件...>           用标准 LUT 转换
  dlog -l dlogm <文件...>        用 D-Log M LUT 转换

LUT 预设:                                        快捷参数
  vivid    鲜艳模式，色彩饱和对比高 (默认)        -l vivid
  std      标准模式，色彩自然准确                  -l std
  dlogm    D-Log M 专用转换                       -l dlogm

选项:
  -l, --look <预设>          LUT 预设 (vivid/std/dlogm, 默认: vivid)
  --lut <文件.cube>          使用自定义 LUT 文件
  --list                     列出可用的 LUT 文件
  -c, --codec <编码>         h264/h265/prores (默认: h265)
  -q, --quality <数字>       质量 (默认: 22, 越小越好)
  -b, --bitrate <码率>       固定码率, 如 30M
  -o, --output-dir <目录>    输出目录
  -s, --suffix <后缀>        输出后缀 (默认: _rec709)
  -j, --parallel <数>        并行数 (默认: 1)
  -y, --overwrite            覆盖已有文件
  -n, --dry-run              仅预览
  -v, --verbose              详细输出
  -V, --version              版本
  -h, --help                 帮助

示例:
  dlog                            # 自动找 _D 视频，vivid 模式
  dlog -l std *.MP4               # 标准模式批量转换
  dlog -l dlogm DJI_001_D.MP4    # D-Log M 转换
  dlog -c h264 -q 18 *.MP4       # H.264 高质量
  dlog --lut custom.cube *.MP4    # 自定义 LUT
  dlog --list                     # 查看已安装的 LUT

LUT 目录: ${DATA_DIR}/
下载地址: https://www.dji.com/lut
EOF
}

# ── 参数解析 ────────────────────────────────────────────
INPUTS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--look)       LUT_PRESET="$2"; shift 2 ;;
        --lut)           LUT_FILE="$2"; shift 2 ;;
        --list)          LIST_LUTS=true; shift ;;
        -c|--codec)      CODEC="$2"; shift 2 ;;
        -q|--quality)    QUALITY="$2"; shift 2 ;;
        -b|--bitrate)    BITRATE="$2"; shift 2 ;;
        -o|--output-dir) OUTPUT_DIR="$2"; shift 2 ;;
        -s|--suffix)     SUFFIX="$2"; shift 2 ;;
        -j|--parallel)   PARALLEL="$2"; shift 2 ;;
        -y|--overwrite)  OVERWRITE=true; shift ;;
        -n|--dry-run)    DRY_RUN=true; shift ;;
        -v|--verbose)    VERBOSE=true; shift ;;
        -V|--version)    echo "dlog v${VERSION}"; exit 0 ;;
        -h|--help)       usage; exit 0 ;;
        -*)              err "未知选项: $1"; echo ""; usage; exit 1 ;;
        *)               INPUTS+=("$1"); shift ;;
    esac
done

# ── 前置检查 ────────────────────────────────────────────
if ! command -v ffmpeg &>/dev/null; then
    err "未找到 ffmpeg，请先安装: brew install ffmpeg"
    exit 1
fi

# ── 列出 LUT 文件 ──────────────────────────────────────
if $LIST_LUTS; then
    echo -e "${BOLD}已安装的 LUT 文件:${NC}"
    echo ""
    found=false
    for dir in "$DATA_DIR" "$SCRIPT_DIR"; do
        [[ -d "$dir" ]] || continue
        while IFS= read -r -d '' f; do
            found=true
            base="$(basename "$f")"
            # 判断属于哪个预设
            tag=""
            if [[ "$base" == *vivid* ]]; then
                tag="${GREEN}vivid${NC}"
            elif [[ "$base" == *"D-Log M"* ]]; then
                tag="${CYAN}dlogm${NC}"
            elif [[ "$base" == *"D-Log"* ]]; then
                tag="${BLUE}std${NC}"
            fi
            printf "  %-8b %s\n" "[$tag]" "$base"
        done < <(find "$dir" -maxdepth 1 -name "*.cube" -print0 2>/dev/null | sort -z)
    done
    if ! $found; then
        warn "未找到 LUT 文件"
        info "请从 https://www.dji.com/lut 下载后放到 $DATA_DIR/"
    fi
    exit 0
fi

# ── 查找 LUT 文件 ──────────────────────────────────────
# 按预设在目录中匹配 LUT (结果写入 LUT_PATH)
search_lut_in_dir() {
    local dir="$1" preset="$2"
    [[ -d "$dir" ]] || return 1

    local f base
    for f in "$dir"/*.cube; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        case "$preset" in
            vivid)
                if [[ "$base" == *vivid* ]]; then
                    LUT_PATH="$f"; return 0
                fi
                ;;
            std)
                if [[ "$base" == *"D-Log to Rec.709"* ]] && \
                   [[ "$base" != *vivid* ]] && \
                   [[ "$base" != *"D-Log M"* ]]; then
                    LUT_PATH="$f"; return 0
                fi
                ;;
            dlogm)
                if [[ "$base" == *"D-Log M"* ]]; then
                    LUT_PATH="$f"; return 0
                fi
                ;;
            any)
                LUT_PATH="$f"; return 0
                ;;
        esac
    done
    return 1
}

resolve_lut() {
    local preset="${1:-$DEFAULT_PRESET}"

    # 1. --lut 直接指定
    if [[ -n "$LUT_FILE" ]]; then
        if [[ ! -f "$LUT_FILE" ]]; then
            err "LUT 文件不存在: $LUT_FILE"
            exit 1
        fi
        LUT_PATH="$(cd "$(dirname "$LUT_FILE")" && pwd)/$(basename "$LUT_FILE")"
        return
    fi

    # 2. 按预设查找 (DATA_DIR 优先，再找 SCRIPT_DIR)
    if search_lut_in_dir "$DATA_DIR" "$preset"; then return; fi
    if search_lut_in_dir "$SCRIPT_DIR" "$preset"; then return; fi

    # 3. fallback 到任意可用 LUT
    if [[ "$preset" != "any" ]]; then
        warn "未找到 '$preset' 预设的 LUT，尝试其他..."
        if search_lut_in_dir "$DATA_DIR" "any"; then return; fi
        if search_lut_in_dir "$SCRIPT_DIR" "any"; then return; fi
    fi

    err "未找到 LUT 文件"
    err "请从 https://www.dji.com/lut 下载 .cube 文件放到 $DATA_DIR/"
    exit 1
}

# 验证预设名
if [[ -n "$LUT_PRESET" ]]; then
    valid=false
    for p in $KNOWN_PRESETS; do
        [[ "$p" == "$LUT_PRESET" ]] && valid=true
    done
    if ! $valid; then
        err "未知预设: $LUT_PRESET"
        info "可用预设: vivid, std, dlogm"
        exit 1
    fi
fi

resolve_lut "${LUT_PRESET:-$DEFAULT_PRESET}"
info "LUT: $(basename "$LUT_PATH")"

# ── 无参数时：自动扫描当前目录 _D 视频 ─────────────────
if [[ ${#INPUTS[@]} -eq 0 ]]; then
    INPUTS=(".")
    AUTO_MODE=true
else
    AUTO_MODE=false
fi

# ── 收集文件列表 ────────────────────────────────────────
FILES=()
VIDEO_EXTS="mp4|MP4|mov|MOV|mkv|MKV|mxf|MXF|m4v|M4V"

for input in "${INPUTS[@]}"; do
    if [[ -d "$input" ]]; then
        while IFS= read -r -d '' f; do
            FILES+=("$f")
        done < <(find "$input" -maxdepth 1 -type f | grep -iE "\\.($VIDEO_EXTS)$" | tr '\n' '\0')
    elif [[ -f "$input" ]]; then
        FILES+=("$input")
    else
        warn "跳过: $input (不存在)"
    fi
done

# 自动模式下只处理 _D 文件
if $AUTO_MODE; then
    FILTERED=()
    for f in "${FILES[@]}"; do
        base="$(basename "$f")"
        if [[ "$base" =~ _[Dd]\.(mp4|MP4|mov|MOV|mkv|MKV|mxf|MXF|m4v|M4V)$ ]]; then
            FILTERED+=("$f")
        fi
    done
    if [[ ${#FILTERED[@]} -eq 0 ]]; then
        FILES=()
    else
        FILES=("${FILTERED[@]}")
    fi

    if [[ ${#FILES[@]} -eq 0 ]]; then
        info "当前目录没有找到 D-Log 视频 (文件名含 _D 的视频文件)"
        info "用法: dlog <文件...>  或  dlog --help"
        exit 0
    fi
fi

if [[ ${#FILES[@]} -eq 0 ]]; then
    warn "没有找到视频文件"
    exit 0
fi

# ── ffmpeg 编码参数 ──────────────────────────────────────
build_codec_args() {
    local args=()
    case "$CODEC" in
        h264)
            if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_videotoolbox; then
                args+=(-c:v h264_videotoolbox)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-q:v "$QUALITY")
                args+=(-profile:v high)
            else
                args+=(-c:v libx264)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-crf "$QUALITY" -preset medium)
            fi
            ;;
        h265)
            if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q hevc_videotoolbox; then
                args+=(-c:v hevc_videotoolbox)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-q:v "$QUALITY")
                args+=(-profile:v main10 -pix_fmt p010le -tag:v hvc1)
            else
                args+=(-c:v libx265)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-crf "$QUALITY" -preset medium)
                args+=(-tag:v hvc1)
            fi
            ;;
        prores)
            args+=(-c:v prores_ks -profile:v 3 -pix_fmt yuv422p10le)
            ;;
        *)
            err "不支持的编码: $CODEC (可选: h264, h265, prores)"
            exit 1
            ;;
    esac
    echo "${args[@]}"
}

# ── 输出路径 ────────────────────────────────────────────
get_output_path() {
    local input="$1" dir base ext
    if [[ -n "$OUTPUT_DIR" ]]; then
        dir="$OUTPUT_DIR"; mkdir -p "$dir"
    else
        dir="$(dirname "$input")"
    fi
    base="$(basename "$input")"
    ext="${base##*.}"
    base="${base%.*}"
    [[ "$CODEC" == "prores" ]] && ext="mov"
    echo "$dir/${base}${SUFFIX}.${ext}"
}

# ── 转换单个文件 ────────────────────────────────────────
convert_file() {
    local input="$1" index="$2" total="$3"
    local output basename_in
    output="$(get_output_path "$input")"
    basename_in="$(basename "$input")"

    echo ""
    echo -e "${BOLD}[${index}/${total}]${NC} ${CYAN}${basename_in}${NC}"

    if [[ -f "$output" ]] && ! $OVERWRITE; then
        warn "已存在，跳过: $(basename "$output")  (用 -y 覆盖)"
        return 0
    fi

    local codec_args
    read -ra codec_args <<< "$(build_codec_args)"

    local cmd=(ffmpeg -hide_banner)
    $VERBOSE || cmd+=(-loglevel warning -stats)
    $OVERWRITE && cmd+=(-y)
    cmd+=(
        -i "$input"
        -vf "lut3d=file='${LUT_PATH}':interp=tetrahedral"
        "${codec_args[@]}"
        -c:a copy
        "$output"
    )

    if $DRY_RUN; then
        info "命令: ${cmd[*]}"
        return 0
    fi

    local t0
    t0=$(date +%s)

    if "${cmd[@]}"; then
        local dt in_sz out_sz
        dt=$(( $(date +%s) - t0 ))
        in_sz=$(du -h "$input" | cut -f1 | xargs)
        out_sz=$(du -h "$output" | cut -f1 | xargs)
        ok "完成 (${dt}s) ${in_sz} → ${out_sz}  $(basename "$output")"
    else
        err "失败: $basename_in"
        return 1
    fi
}

# ── 主流程 ──────────────────────────────────────────────
TOTAL=${#FILES[@]}

echo ""
echo -e "${BOLD}dlog${NC} — DJI D-Log → Rec.709"
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
info "文件: ${TOTAL} 个"
info "LUT:  $(basename "$LUT_PATH")"
info "编码: ${CODEC} | 质量: ${QUALITY}"
$DRY_RUN && warn "试运行 — 不会实际转换"

FAIL=0
I=0

if [[ "$PARALLEL" -gt 1 ]]; then
    for f in "${FILES[@]}"; do
        (( I++ ))
        convert_file "$f" "$I" "$TOTAL" &
        (( I % PARALLEL == 0 )) && wait
    done
    wait
else
    for f in "${FILES[@]}"; do
        (( I++ ))
        convert_file "$f" "$I" "$TOTAL" || (( FAIL++ ))
    done
fi

echo ""
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ $FAIL -eq 0 ]]; then
    ok "全部完成! ${TOTAL} 个文件已转换"
else
    warn "完成，${FAIL}/${TOTAL} 个失败"
    exit 1
fi
