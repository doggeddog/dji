#!/usr/bin/env bash
#
# dlog — DJI D-Log 视频色彩转换工具
#
# 将灰蒙蒙的 D-Log / D-Log M 视频转换为 Rec.709 标准色彩。
# 基于 ffmpeg + 3D LUT，支持 macOS 硬件加速编码。
#
# 用法:
#   dlog                                # 转换当前目录下所有 _D 视频
#   dlog DJI_001_D.MP4                  # 转换指定文件
#   dlog -c h264 *.MP4                  # 指定 H.264 编码
#   dlog --lut custom.cube *.MP4        # 使用自定义 LUT
#
set -eo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# LUT 搜索目录 (优先级: 环境变量 > ~/.local > /usr/local > 脚本目录)
if [[ -n "${DLOG_DATA_DIR:-}" ]]; then
    DATA_DIR="$DLOG_DATA_DIR"
elif [[ -d "$HOME/.local/share/dlog" ]]; then
    DATA_DIR="$HOME/.local/share/dlog"
else
    DATA_DIR="/usr/local/share/dlog"
fi

# ── 默认参数 ────────────────────────────────────────────
CODEC="h265"
QUALITY=22
BITRATE=""
LUT_FILE=""
OUTPUT_DIR=""
SUFFIX="_rec709"
DRY_RUN=false
OVERWRITE=false
PARALLEL=1
VERBOSE=false

# ── 颜色输出 ────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${BLUE}ℹ${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
err()   { echo -e "${RED}✗${NC} $*" >&2; }

# ── 帮助信息 ────────────────────────────────────────────
usage() {
    cat <<EOF
dlog v${VERSION} — DJI D-Log 视频色彩转换工具

将灰蒙蒙的 D-Log / D-Log M 视频转换为 Rec.709 标准色彩。

用法:
  dlog                                  # 转换当前目录下所有 _D 视频
  dlog <文件...>                        # 转换指定文件
  dlog [选项] <文件或目录...>           # 带选项转换

选项:
  -c, --codec <h264|h265|prores>  输出编码 (默认: h265)
  -q, --quality <数字>             质量 (默认: 22, 越小越好, 18=高质量)
  -b, --bitrate <码率>             固定码率, 如 30M
  --lut <文件.cube>                使用自定义 LUT 文件
  -o, --output-dir <目录>          输出目录 (默认: 源文件同目录)
  -s, --suffix <后缀>              输出后缀 (默认: _rec709)
  -j, --parallel <数>              并行数 (默认: 1)
  -y, --overwrite                  覆盖已有文件
  -n, --dry-run                    仅预览，不实际转换
  -v, --verbose                    显示 ffmpeg 详细输出
  -V, --version                    显示版本
  -h, --help                       显示帮助

编码:
  h265     更小文件，画质好 (默认, macOS 硬件加速)
  h264     兼容性最好 (macOS 硬件加速)
  prores   ProRes 422 HQ 专业格式

示例:
  dlog                                  # 最简用法，自动找 _D 视频
  dlog DJI_001_D.MP4                    # 转换单个文件
  dlog -c h264 -q 18 *.MP4             # H.264 高质量批量转换
  dlog --lut Mavic4Pro.cube *.MP4       # 自定义 LUT
  dlog -o ./output -j 2 *.MP4          # 输出到指定目录，2路并行

LUT 文件查找顺序:
  1. --lut 参数指定的文件
  2. ${DATA_DIR}/ 下的官方 .cube 文件
  3. 脚本目录下的官方 .cube 文件
  4. 内置通用 dlog_m_to_rec709.cube

添加官方 LUT: 将 .cube 文件放到 ${DATA_DIR}/ 即可自动识别
下载地址: https://www.dji.com/lut
EOF
}

# ── 参数解析 ────────────────────────────────────────────
INPUTS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--codec)      CODEC="$2"; shift 2 ;;
        -q|--quality)    QUALITY="$2"; shift 2 ;;
        -b|--bitrate)    BITRATE="$2"; shift 2 ;;
        --lut)           LUT_FILE="$2"; shift 2 ;;
        -o|--output-dir) OUTPUT_DIR="$2"; shift 2 ;;
        -s|--suffix)     SUFFIX="$2"; shift 2 ;;
        -j|--parallel)   PARALLEL="$2"; shift 2 ;;
        -y|--overwrite)  OVERWRITE=true; shift ;;
        -n|--dry-run)    DRY_RUN=true; shift ;;
        -v|--verbose)    VERBOSE=true; shift ;;
        -V|--version)    echo "dlog v${VERSION}"; exit 0 ;;
        -h|--help)       usage; exit 0 ;;
        -*)              err "未知选项: $1"; echo ""; usage; exit 1 ;;
        *)               INPUTS+=("$1"); shift ;;
    esac
done

# ── 前置检查 ────────────────────────────────────────────
if ! command -v ffmpeg &>/dev/null; then
    err "未找到 ffmpeg，请先安装: brew install ffmpeg"
    exit 1
fi

# ── 无参数时：自动扫描当前目录 _D 视频 ─────────────────
if [[ ${#INPUTS[@]} -eq 0 ]]; then
    INPUTS=(".")
    AUTO_MODE=true
else
    AUTO_MODE=false
fi

# ── 查找 LUT 文件 ──────────────────────────────────────
# 在指定目录中查找官方 LUT (非内置的 .cube 文件)
find_official_lut() {
    local dir="$1"
    [[ -d "$dir" ]] || return 1
    while IFS= read -r -d '' cubefile; do
        local base
        base="$(basename "$cubefile")"
        if [[ "$base" != "dlog_m_to_rec709.cube" ]]; then
            echo "$cubefile"
            return 0
        fi
    done < <(find "$dir" -maxdepth 1 -name "*.cube" -print0 2>/dev/null | sort -z)
    return 1
}

if [[ -n "$LUT_FILE" ]]; then
    if [[ ! -f "$LUT_FILE" ]]; then
        err "LUT 文件不存在: $LUT_FILE"
        exit 1
    fi
    LUT_PATH="$(cd "$(dirname "$LUT_FILE")" && pwd)/$(basename "$LUT_FILE")"
elif LUT_PATH="$(find_official_lut "$DATA_DIR")"; then
    info "LUT: $(basename "$LUT_PATH")"
elif LUT_PATH="$(find_official_lut "$SCRIPT_DIR")"; then
    info "LUT: $(basename "$LUT_PATH")"
else
    err "未找到 LUT 文件"
    err "请从 https://www.dji.com/lut 下载你机型的 .cube 文件"
    err "放到 $DATA_DIR/ 目录下，或使用 --lut 指定路径"
    exit 1
fi

# ── 收集文件列表 ────────────────────────────────────────
FILES=()
VIDEO_EXTS="mp4|MP4|mov|MOV|mkv|MKV|mxf|MXF|m4v|M4V"

for input in "${INPUTS[@]}"; do
    if [[ -d "$input" ]]; then
        while IFS= read -r -d '' f; do
            FILES+=("$f")
        done < <(find "$input" -maxdepth 1 -type f | grep -iE "\\.($VIDEO_EXTS)$" | tr '\n' '\0')
    elif [[ -f "$input" ]]; then
        FILES+=("$input")
    else
        warn "跳过: $input (不存在)"
    fi
done

# 自动模式下只处理 _D 文件
if $AUTO_MODE; then
    FILTERED=()
    for f in "${FILES[@]}"; do
        base="$(basename "$f")"
        if [[ "$base" =~ _[Dd]\.(mp4|MP4|mov|MOV|mkv|MKV|mxf|MXF|m4v|M4V)$ ]]; then
            FILTERED+=("$f")
        fi
    done
    if [[ ${#FILTERED[@]} -eq 0 ]]; then
        FILES=()
    else
        FILES=("${FILTERED[@]}")
    fi

    if [[ ${#FILES[@]} -eq 0 ]]; then
        info "当前目录没有找到 D-Log 视频 (文件名含 _D 的视频文件)"
        info "用法: dlog <文件...>  或  dlog --help"
        exit 0
    fi
fi

if [[ ${#FILES[@]} -eq 0 ]]; then
    warn "没有找到视频文件"
    exit 0
fi

# ── ffmpeg 编码参数 ──────────────────────────────────────
build_codec_args() {
    local args=()
    case "$CODEC" in
        h264)
            if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_videotoolbox; then
                args+=(-c:v h264_videotoolbox)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-q:v "$QUALITY")
                args+=(-profile:v high)
            else
                args+=(-c:v libx264)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-crf "$QUALITY" -preset medium)
            fi
            ;;
        h265)
            if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q hevc_videotoolbox; then
                args+=(-c:v hevc_videotoolbox)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-q:v "$QUALITY")
                args+=(-profile:v main10 -pix_fmt p010le -tag:v hvc1)
            else
                args+=(-c:v libx265)
                [[ -n "$BITRATE" ]] && args+=(-b:v "$BITRATE") || args+=(-crf "$QUALITY" -preset medium)
                args+=(-tag:v hvc1)
            fi
            ;;
        prores)
            args+=(-c:v prores_ks -profile:v 3 -pix_fmt yuv422p10le)
            ;;
        *)
            err "不支持的编码: $CODEC (可选: h264, h265, prores)"
            exit 1
            ;;
    esac
    echo "${args[@]}"
}

# ── 输出路径 ────────────────────────────────────────────
get_output_path() {
    local input="$1" dir base ext
    if [[ -n "$OUTPUT_DIR" ]]; then
        dir="$OUTPUT_DIR"; mkdir -p "$dir"
    else
        dir="$(dirname "$input")"
    fi
    base="$(basename "$input")"
    ext="${base##*.}"
    base="${base%.*}"
    [[ "$CODEC" == "prores" ]] && ext="mov"
    echo "$dir/${base}${SUFFIX}.${ext}"
}

# ── 转换单个文件 ────────────────────────────────────────
convert_file() {
    local input="$1" index="$2" total="$3"
    local output basename_in
    output="$(get_output_path "$input")"
    basename_in="$(basename "$input")"

    echo ""
    echo -e "${BOLD}[${index}/${total}]${NC} ${CYAN}${basename_in}${NC}"

    if [[ -f "$output" ]] && ! $OVERWRITE; then
        warn "已存在，跳过: $(basename "$output")  (用 -y 覆盖)"
        return 0
    fi

    local codec_args
    read -ra codec_args <<< "$(build_codec_args)"

    local cmd=(ffmpeg -hide_banner)
    $VERBOSE || cmd+=(-loglevel warning -stats)
    $OVERWRITE && cmd+=(-y)
    cmd+=(
        -i "$input"
        -vf "lut3d=file='${LUT_PATH}':interp=tetrahedral"
        "${codec_args[@]}"
        -c:a copy
        "$output"
    )

    if $DRY_RUN; then
        info "命令: ${cmd[*]}"
        return 0
    fi

    local t0
    t0=$(date +%s)

    if "${cmd[@]}"; then
        local dt in_sz out_sz
        dt=$(( $(date +%s) - t0 ))
        in_sz=$(du -h "$input" | cut -f1 | xargs)
        out_sz=$(du -h "$output" | cut -f1 | xargs)
        ok "完成 (${dt}s) ${in_sz} → ${out_sz}  $(basename "$output")"
    else
        err "失败: $basename_in"
        return 1
    fi
}

# ── 主流程 ──────────────────────────────────────────────
TOTAL=${#FILES[@]}

echo ""
echo -e "${BOLD}dlog${NC} — DJI D-Log → Rec.709"
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
info "文件: ${TOTAL} 个"
info "LUT:  $(basename "$LUT_PATH")"
info "编码: ${CODEC} | 质量: ${QUALITY}"
$DRY_RUN && warn "试运行 — 不会实际转换"

FAIL=0
I=0

if [[ "$PARALLEL" -gt 1 ]]; then
    for f in "${FILES[@]}"; do
        (( I++ ))
        convert_file "$f" "$I" "$TOTAL" &
        (( I % PARALLEL == 0 )) && wait
    done
    wait
else
    for f in "${FILES[@]}"; do
        (( I++ ))
        convert_file "$f" "$I" "$TOTAL" || (( FAIL++ ))
    done
fi

echo ""
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ $FAIL -eq 0 ]]; then
    ok "全部完成! ${TOTAL} 个文件已转换"
else
    warn "完成，${FAIL}/${TOTAL} 个失败"
    exit 1
fi
